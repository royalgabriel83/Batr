# Copy to apps/web/.env.local (git-ignored) and fill in values.
# For local development, `pnpm env:local` writes this file from the
# running local Supabase. Never commit real values.

# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never import into client code or use for member
# requests. Used only to delete queued photo files (right after a
# commit, and by the storage cleanup job) and in test setup.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Protects /api/internal/storage-cleanup.
CRON_SECRET=
